local function shutdown()
	running = false
	autoAttack, tpAttack, tpEnemy, keepDistance, autoChest = false, false, false, false, false
	chestBusy = false
	attackToken += 1
	chestToken += 1

	stopFly()
	setNoclip(false)

	pcall(function() RunService:UnbindFromRenderStep("CFlyCombat") end)
	pcall(function() RunService:UnbindFromRenderStep("CFlyTeleport") end)

	for _, c in ipairs(allConnections) do
		c:Disconnect()
	end
	table.clear(allConnections)

	local hum, root = getParts()
	if hum then
		hum.AutoRotate = true
	end
	if root then
		root.Anchored = false
	end

	gui:Destroy()
end

