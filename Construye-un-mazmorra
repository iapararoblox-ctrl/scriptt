-- Ajusta el tamaño del panel a la pantalla (por si es un celular pequeño o se gira)
local function fitPanel()
	local screen = gui.AbsoluteSize
	if screen.X <= 0 then return end
	panelW = math.min(PANEL_W, screen.X - EDGE * 2)
	panelFullH = math.min(FULL_H, screen.Y - TOP_EDGE - EDGE)
	panel.Size = UDim2.fromOffset(panelW, minimized and MIN_H or panelFullH)
end

