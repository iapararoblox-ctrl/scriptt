---------------------------------------------------------------------
local function getCrystalModels()
	local list = {}
	for _, m in ipairs(workspace:GetDescendants()) do
		if m:IsA("Model") and m.Name == CRYSTAL_NAME and m.Parent then
			table.insert(list, m)
		end
	end
	return list
end

local function crystalAlive(m)
	if not m or not m.Parent then return false end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return false end
	return true
end

local function teleportNearCrystal(model)
	local _, root = getParts()
	if not root then return end
	local pos = model:GetPivot().Position
	local offset = root.Position - pos
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local away = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
	local dest = pos + away * CRYSTAL_TP_DISTANCE + Vector3.new(0, 1.5, 0)
	root.CFrame = CFrame.lookAt(dest, Vector3.new(pos.X, dest.Y, pos.Z))
	root.AssemblyLinearVelocity = Vector3.zero
end

-- Dispara al cristal hasta romperlo, o hasta el tiempo límite
local function farmCrystal(model)
	local startT = os.clock()
	while running and crystalFarm and crystalAlive(model) and os.clock() - startT < CRYSTAL_TIMEOUT do
		local hum, root = getParts()
		if hum and root and hum.Health > 0 and not healBusy then -- healBusy NUEVO
			teleportNearCrystal(model)
			fireAttack()
		end
		task.wait(CRYSTAL_ATTACK_INTERVAL)
	end
end

local function updateCrystalLabel()
	if crystalSub then
		crystalSub.Text = "Cristales rotos: " .. crystalsCollected
	end
end

local function startCrystalLoop()
	crystalToken += 1
	local token = crystalToken
	task.spawn(function()
		while running and crystalFarm and token == crystalToken do
			local hum, root = getParts()
			if hum and root and hum.Health > 0 and not healBusy then -- healBusy NUEVO
				local best, bestD
				local now = os.clock()
				for _, m in ipairs(getCrystalModels()) do
					if not crystalSkip[m] or now > crystalSkip[m] then
						local d = (m:GetPivot().Position - root.Position).Magnitude
						if not bestD or d < bestD then
							best, bestD = m, d
						end
					end
				end

				if best then
					crystalBusy = true
					pcall(farmCrystal, best)
					if not crystalAlive(best) then
						crystalsCollected += 1
						updateCrystalLabel()
					else
						crystalSkip[best] = os.clock() + CRYSTAL_SKIP_TIME
					end
					crystalBusy = false
				else
					task.wait(1)
				end
			else
				task.wait(0.5)
			end
			task.wait(0.05)
		end
		crystalBusy = false
	end)
end

local function setCrystalFarm(state)
	crystalFarm = state
	crystalToken += 1
	if state then
		crystalSkip = {}
		startCrystalLoop()
	else
		crystalBusy = false
	end
end

---------------------------------------------------------------------
-- AUTO-CURAR EN FOUNTAIN (NUEVO)
-- Al 20% de vida: guarda posición, va al Fountain, usa su ProximityPrompt,
-- espera la curación y regresa a la posición original.
---------------------------------------------------------------------
local function getPosition(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	return nil
end

-- Busca la Part/Model "Fountain" y su ProximityPrompt
local function findFountain()
	local found
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == FOUNTAIN_NAME and (d:IsA("BasePart") or d:IsA("Model")) then
			local prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt and prompt.Enabled then
				return d, prompt
			end
			found = found or d
		end
	end

	-- Si el prompt no está dentro de Fountain, busca uno cercano
	if found then
		local pos = getPosition(found)
		local closest, closestD
		if pos then
			for _, p in ipairs(workspace:GetDescendants()) do
				if p:IsA("ProximityPrompt") and p.Enabled then
					local pp = promptPosition(p)
					if pp then
						local dist = (pp - pos).Magnitude
						if dist < 15 and (not closestD or dist < closestD) then
							closest, closestD = p, dist
						end
					end
				end
			end
		end
		return found, closest
	end

	return nil, nil
end

local function healAtFountain()
	local hum, root = getParts()
	if not hum or not root or hum.Health <= 0 then return false end

	local fountain, prompt = findFountain()
	if not fountain or not prompt then
		warnOnce("fountain", "No encontré Fountain con ProximityPrompt")
		return false
	end

	healToken += 1
	local token = healToken
	healBusy = true

	local savedCF = root.CFrame
	local wasAnchored = root.Anchored
	local fpos = promptPosition(prompt) or getPosition(fountain)

	pcall(function()
		prompt.RequiresLineOfSight = false
		if prompt.MaxActivationDistance < 12 then
			prompt.MaxActivationDistance = 12
		end
	end)

	-- Ir a la fuente
	root.CFrame = CFrame.new(fpos + Vector3.new(0, HEAL_HEIGHT, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	if not flying then
		root.Anchored = true
	end

	task.wait(HEAL_TP_DELAY)

	-- Interactuar con el ProximityPrompt
	if prompt.Parent and prompt.Enabled then
		pcall(function() prompt:InputHoldBegin() end)
	end

	-- Esperar a que se cure
	local startT = os.clock()
	while running and token == healToken and hum.Health > 0
		and os.clock() - startT < HEAL_TIMEOUT do
		if hum.Health >= hum.MaxHealth * HEAL_DONE then
			break
		end
		task.wait(0.1)
	end

	pcall(function() prompt:InputHoldEnd() end)

	-- Regresar a la posición original
	if token == healToken and root.Parent then
		root.CFrame = savedCF
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = wasAnchored
		healBusy = false
	end

	return true
end

local function setAutoHeal(state)
	autoHeal = state
	healLoopToken += 1
	if state then
		local token = healLoopToken
		task.spawn(function()
			while running and autoHeal and token == healLoopToken do
				local hum = getParts()
				if hum and hum.Health > 0
					and hum.Health <= hum.MaxHealth * HEAL_THRESHOLD
					and not isBusy() then
					pcall(healAtFountain)
					task.wait(HEAL_COOLDOWN)
				end
				task.wait(0.2)
			end
		end)
	end
end

