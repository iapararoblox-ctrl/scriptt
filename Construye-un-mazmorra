	s.TextTruncate = Enum.TextTruncate.AtEnd
	s.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.fromOffset(52, 30)
	track.Position = UDim2.new(1, -66, 0.5, -15)
	track.BackgroundColor3 = COLORS.off
	track.BorderSizePixel = 0
	track.Parent = row
	corner(track, UDim.new(1, 0))

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(24, 24)
	knob.Position = UDim2.new(0, 3, 0.5, -12)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = track
	corner(knob, UDim.new(1, 0))

	-- Toda la fila es táctil (más fácil en celular)
	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.ZIndex = 5
	hit.Parent = row

	local state = initial
	local function set(value, silent)
		state = value
		tween(track, { BackgroundColor3 = value and COLORS.on or COLORS.off })
		tween(knob, { Position = value and UDim2.new(1, -27, 0.5, -12) or UDim2.new(0, 3, 0.5, -12) })
		if not silent then
			callback(value)
		end
	end

	hit.Activated:Connect(function()
		set(not state)
	end)

	set(initial, true)
	return set
end

