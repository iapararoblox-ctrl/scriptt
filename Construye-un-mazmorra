	local state = initial
	local function set(value, silent)
		state = value
		tween(track_, { BackgroundColor3 = value and COLORS.on or COLORS.off })
		tween(knob, { Position = value and UDim2.new(1, -27, 0.5, -12) or UDim2.new(0, 3, 0.5, -12) })
		if not silent then
			callback(value)
		end
	end

	hit.Activated:Connect(function()
		set(not state)
	end)

	set(initial, true)
	return set
end

-- Selector: cuerpo a cuerpo / a distancia
local function createModeSelector(order)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 58)
	row.BackgroundColor3 = COLORS.row
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.Parent = body
	corner(row, UDim.new(0, 14))

	local buttons = {}

	local function selectMode(mode)
		combatMode = mode
		for key, b in pairs(buttons) do
			local active = key == mode
			tween(b, { BackgroundColor3 = active and COLORS.accentA or COLORS.off })
			b.TextColor3 = active and Color3.new(1, 1, 1) or COLORS.subtext
		end
	end

	local function makeButton(mode, text, position)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.5, -12, 0, 40)
		b.Position = position
		b.Text = text
		b.Font = Enum.Font.GothamBold
		b.TextSize = 13
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.BackgroundColor3 = COLORS.off
		b.Parent = row
		corner(b, UDim.new(0, 10))
		b.Activated:Connect(function()
			selectMode(mode)
		end)
		buttons[mode] = b
	end

	makeButton("melee", "Cuerpo a cuerpo", UDim2.new(0, 8, 0.5, -20))
	makeButton("ranged", "A distancia", UDim2.new(0.5, 4, 0.5, -20))
	selectMode(combatMode)
end

