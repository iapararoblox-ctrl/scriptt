-- Márgenes para que nada quede pegado/fuera de la pantalla
local EDGE = 8       -- margen izquierdo/derecho/inferior
local TOP_EDGE = 44  -- margen superior (deja libre el menú de Roblox)

-- Coloca un objeto en (x, y) de pantalla (esquina superior izquierda),
-- limitándolo SIEMPRE a que quede dentro de la pantalla.
local function placeAt(obj, x, y)
	local screen = gui.AbsoluteSize
	if screen.X <= 0 or screen.Y <= 0 then return end
	local size = obj.AbsoluteSize
	local maxX = math.max(EDGE, screen.X - size.X - EDGE)
	local maxY = math.max(TOP_EDGE, screen.Y - size.Y - EDGE)
	x = math.clamp(x, EDGE, maxX)
	y = math.clamp(y, TOP_EDGE, maxY)
	obj.Position = UDim2.fromOffset(
		x + obj.AnchorPoint.X * size.X,
		y + obj.AnchorPoint.Y * size.Y
	)
end

local function clampToScreen(obj)
	local p = obj.AbsolutePosition
	placeAt(obj, p.X, p.Y)
end

-- Hace que "target" se pueda arrastrar tomando "handle" (sin salirse de la pantalla).
-- Si el usuario solo toca (sin arrastrar) se llama a onTap.
local function makeDraggable(handle, target, onTap)
	local dragging, moved = false, false
	local dragStart, startAbs, activeInput

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			activeInput = input
			dragStart = input.Position
			startAbs = target.AbsolutePosition
		end
	end)

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			if delta.Magnitude > 8 then
				moved = true
			end
			if moved then
				placeAt(target, startAbs.X + delta.X, startAbs.Y + delta.Y)
			end
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if not moved and onTap then
				onTap()
			end
		end
	end))
end

