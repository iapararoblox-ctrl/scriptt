		tween(row, { BackgroundColor3 = value and COLORS.rowOn or COLORS.row })
		tween(knob, { Position = value and UDim2.new(1, -27, 0.5, -12) or UDim2.new(0, 3, 0.5, -12) })
		if not silent then
			callback(value)
		end
	end

	hit.Activated:Connect(function()
