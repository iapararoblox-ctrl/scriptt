-- Función para Teletransportar
local function executeTeleport()
    local text = textBox.Text
    local coords = {}
    
    -- Extraer números (soporta comas, espacios o saltos)
    for num in string.gmatch(text, "[-%d%.]+") do
        table.insert(coords, tonumber(num))
    end
    
    if #coords >= 3 then
        local x, y, z = coords[1], coords[2], coords[3]
        
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            rootPart.CFrame = CFrame.new(x, y, z)
            statusLabel.Text = string.format("Teletransportado a: %.1f, %.1f, %.1f", x, y, z)
            statusLabel.TextColor3 = Color3.fromRGB(87, 242, 135)
        else
            statusLabel.Text = "Error: Personaje no encontrado"
            statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
        end
    else
        statusLabel.Text = "Formato inválido. Usa: X, Y, Z"
        statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
    end
end

tpBtn.MouseButton1Click:Connect(executeTeleport)

