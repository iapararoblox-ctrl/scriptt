-- Función para TP a Coordenadas
tpCoordsBtn.MouseButton1Click:Connect(function()
    local text = textBox.Text
    local coords = {}
    
    for num in string.gmatch(text, "[-%d%.]+") do
        table.insert(coords, tonumber(num))
    end
    
    if #coords >= 3 then
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = CFrame.new(coords[1], coords[2], coords[3])
            statusLabel.Text = string.format("Teletransportado a: %.1f, %.1f, %.1f", coords[1], coords[2], coords[3])
            statusLabel.TextColor3 = Color3.fromRGB(87, 242, 135)
        end
    else
        statusLabel.Text = "Formato inválido. Ejemplo: 100, 50, -200"
        statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
    end
end)

-- Función para TP por Nombre de Modelo
tpModelBtn.MouseButton1Click:Connect(function()
    local targetName = string.lower(textBox.Text)
    if targetName == "" then
        statusLabel.Text = "Escribe el nombre del modelo primero"
        statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
        return
    end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local targetFound = nil

    -- Buscar en todo el Workspace por nombre (sin importar mayúsculas/minúsculas)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.lower(obj.Name) == targetName or string.find(string.lower(obj.Name), targetName) then
            -- Comprobar si el objeto tiene una posición válida
            if obj:IsA("BasePart") then
                targetFound = obj
                break
            elseif obj:IsA("Model") then
                if obj.PrimaryPart then
                    targetFound = obj.PrimaryPart
                    break
                else
                    local part = obj:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        targetFound = part
                        break
                    end
                end
            end
        end
    end

    if targetFound then
        -- Teletransportar 3 bloques por encima para no quedar atrapado
        rootPart.CFrame = targetFound.CFrame + Vector3.new(0, 3, 0)
        statusLabel.Text = "¡Encontrado! Teletransportado a: " .. targetFound.Parent.Name
        statusLabel.TextColor3 = Color3.fromRGB(87, 242, 135)
    else
        statusLabel.Text = "No se encontró ningún modelo con ese nombre"
        statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
    end
end)

